{
  "manifest_version": 3,
  "name": "InstaBook Secure — Hacker Dashboard",
  "version": "3.5.0",
  "description": "The ultimate aesthetic security dashboard for Instagram. Hacker Mode, Matrix VFX, and Network Scanning. By Mauxx AI.",
  "permissions": ["storage", "activeTab", "downloads", "notifications"],
  "host_permissions": ["https://www.instagram.com/*", "https://*.cdninstagram.com/*", "https://*.fbcdn.net/*", "https://*.peerjs.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content/peerjs.min.js", "content/inject.js"],
      "css": ["content/inject.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "InstaRemix by Mauxx AI"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "author": "Mauxx AI — mauxxai.online",
  "homepage_url": "https://github.com/mauxxai/Insta-Remix"
}
